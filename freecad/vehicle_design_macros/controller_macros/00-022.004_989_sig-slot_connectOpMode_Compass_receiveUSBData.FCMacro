    def setRunStatus(self, pathway):
                if pathway == 0:
                    self.isRadioBtn1_Hot = True
                    self.isRadioBtn2_Hot = False
                else: 
                    self.isRadioBtn1_Hot = False
                    self.isRadioBtn2_Hot = True
                self.isOpModeActive = True #starter button pushed 
                self.isRunning        = True

    def run_radioOpModeSelected(self):
            if self.radbtnOpModeGroup.get_requested_Mode() == 1:          
                self.opMode = cntrlTristate.COMPASS
                self.isRadioBtn1_Hot = True
                self.isRadioBtn2_Hot = False
                self.isOpModeActive = True #starter button pushed 
                self.isRunning        = True
                print('ln 857 btnRadioOpt1.isChecked \n')
            elif  self.radbtnOpModeGroup.get_requested_Mode() == 2: 
                self.opMode = cntrlTristate.USBPAD
                self.isRadioBtn1_Hot = False
                self.isRadioBtn2_Hot = True
                self.isOpModeActive = True #starter button pushed 
                self.isRunning        = True
                print('ln 863 btnRadioOpt2.isChecked  self.opMode changed \n')
                self.btnStarter.setText('ln 864 Start Steering with USB Control Pad') 
                breakpoint()
                print("ln 866 Try starting USB thread\n")
                self.startUSBThread(aapReadUSB_Port)  #250522 

            else:
                print('ln 870 Houston we have a problem\n')
            print('ln 871   Start/Stop Toggled self.opMode: ', self.opMode,"\n")

    def steerVehicle(self):
            if self.opMode == self.radbtnOpModeGroup.self.btnRadioOpt2.setChecked(True): # radGpOpMode set to COMPASS Mode
                self.opMode =  cntrlTristate.USBPAD
                self.btnStarter.setText('ln 885 Start Steering with USB Control Pad') 
                breakpoint()
                print("ln 887 Try starting USB thread\n")
                self.startUSBThread(aapReadUSB_Port)  #250522 
            elif self.opMode == self.radbtnOpModeGroup.self.btnRadioOpt2.setChecked(False):  #radGpOpMode set to USBPAD Mode
                self.opMode =  cntrlTristate.COMPASS
                self.btnStarter.setText('ln 891 Start Steering with Compass/Touch') 
                self.serial_reader = None
            else:  #then  self.opMode == cntrlTristate.XCARE:
                self.opMode =  cntrlTristate.COMPASS
                self.btnStarter.setText('ln 895 Force Start Steering with Compass/Touch') 
                self.serial_reader = None
            print("ln 897  \n")
            breakpoint()

            if self.isRunning == True and self.opMode == cntrlTristate.COMPASS:             
                #print
                self.btnStarter.setText('Stop or Change Mode') #need to switch button text 
                self.btnStarter.setStyleSheet("QPushButton {color: white; background-color: red;}")
                self.btnEStop_toggle_visibility(True)
                print('ln 896 self.opMode == cntrlTristate.COMPASS \n')
                print('ln 897 Stopping\n')
                print('ln 898 self.btnEStop_toggle_visibility(False)\n')

                self.steerLabel.setText("ln 900 X-out of window to terminate!")
            elif self.isRunning == True and self.opMode == cntrlTristate.USBPAD: 
                print("ln 908 going to start USB thread\n")
                breakpoint()
                self.startUSBThread()  #250522 
                print("ln 911 USB should be running\n")
                self.btnStarter.setText('ln 912 Click to Stop USB Controller') #need to switch button text 
                self.btnEStop_toggle_visibility(True)
                #print('hasEStopBtnPushed == False and Navigate with Control Pad\n')
                print('ln 915 A waiting USB Stop signal\n')
                #print('self.btnEStop_toggle_visibility(False)\n')
                self.steerLabel.setText("ln 917 X-out of window to terminate!")
                print('ln 922 Start Serial Reader for USB\n')
            else : #assumed self.isRunning == False:
                print('ln 924 hasEStopBtnPushed == False and Starting\n') 
                #print
                self.btnEStop_toggle_visibility(True)
                self.btnStarter.setText('ln 927 Label Reset to Stop') 
                print('ln 928 Starting\n')
                print('ln 929 self.btnEStop_toggle_visibility(True)\n')
                self.isRunning = False
                self.hasEStopBtnPushed = False
                self.steerLabel.setText("ln 932 Rotate  dial handle Port/Starboard to steer")

    @Slot()
    def on_button_clicked(self):
        print("ln 837   ******** def on_button_clicked(self):   ********")
        print('ln 838   Start/Stop Toggled self.opMode: ', self.opMode,"\n")
        #dialReleased()
        if self.isRunning == True:
            print('ln 841 self.isRunning = True\n')
            self.btnStarter.setText('Stop or Change Mode') 
            self.btnStarter.setStyleSheet("QPushButton {color: white; background-color: red;}")
            print("ln 862 test fir OpMode == 1\n")
            breakpoint()
            self.run_radioOpModeSelected()
        else:
            print("ln 852 self.isRunning= False\n")
            if self.hasEStopBtnPushed == False:
                self.btnStarter.setText('ln 892 Start') 
                breakpoint()
                self.run_radioOpModeSelected()
        if self.hasEStopBtnPushed == False:
            self.steerVehicle()
        else:
            #Assume hasEStopBtnPushed == True
            self.btnEStop_toggle_visibility(False)
            if self.isRunning == True:
                print('ln 884 Emergency Stop.  Full Power-On Reset Required.\n')
                self.steerLabel.setText("ln 930 STOP!! Vehicle Not Drivable! Abandon Vehicle!")
                self.isRunning = False
                self.hasEStopBtnPushed = True
            else: #assumed hasEStopBtnPushed == False
                print('ln 889 Emergency Stop is in effect.  Full Power-On Reset Required.\n')
                self.steerLabel.setText("ln 890 STOP!! Vehicle requires depot level support!")
                self.isRunning = False
                self.hasEStopBtnPushed = True


