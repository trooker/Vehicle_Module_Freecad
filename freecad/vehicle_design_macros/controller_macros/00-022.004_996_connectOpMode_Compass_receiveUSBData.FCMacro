    @Slot()
    def on_button_clicked(self):
        """
        logic needs work 
        """
        print("ln 792   ******** def on_button_clicked(self):   ********")
        print('ln 793   Start/Stop Toggled self.mode: ', self.mode,"\n")
        #dialReleased()
        if self.isRunning == True:
            print('ln 798 self.isRunning = True\n')
            self.btnStarter.setText('Stop or Change Mode') 
            if self.radbtnOpModeGroup.get_requested_Mode() == 1:          
                print('ln 797 btnRadioOpt1.isChecked \n')
            elif  self.radbtnOpModeGroup.get_requested_Mode() == 2: 
                print('ln 800 btnRadioOpt2.isChecked \n')
            else:
                print('ln 802 Houston we have a problem\n')
            print('ln 806   Start/Stop Toggled self.mode: ', self.mode,"\n")
            
        else:
            print("ln 805 self.isRunning= False\n")
            if self.hasEStopBtnPushed == False:
                self.btnStarter.setText('ln 775 Start') 
        if self.hasEStopBtnPushed == False:
            if self.mode != self.radbtnOpModeGroup.self.btnRadioOpt2.setChecked(True): # radGpOpMode set to COMPASS Mode
                self.mode =  cntrlTristate.USBPAD
                self.btnStarter.setText('ln 780 Start Steering with USB Control Pad') 
                breakpoint()
                self.startUSBThread()  #250522 
            elif self.mode != self.radbtnOpModeGroup.self.btnRadioOpt2.setChecked(True):  #radGpOpMode set to USBPAD Mode
                self.mode =  cntrlTristate.COMPASS
                self.btnStarter.setText('ln 785 Start Steering with Compass/Touch') 
                self.serial_reader = None
            else:  #then  self.mode == cntrlTristate.XCARE:
                self.mode =  cntrlTristate.COMPASS
                self.btnStarter.setText('ln 789 Force Start Steering with Compass/Touch') 
                self.serial_reader = None

            if self.isRunning == True and self.mode == cntrlTristate.COMPASS:             
                #print
                self.btnStarter.setText('Stop or Change Mode') #need to switch button text 
                self.btnEStop_toggle_visibility(True)
                print('ln 796 self.mode == cntrlTristate.COMPASS \n')
                print('ln 797 Stopping\n')
                print('ln 798 self.btnEStop_toggle_visibility(False)\n')

                self.steerLabel.setText("ln 795 X-out of window to terminate!")
                #self.isRunning = False
                #self.hasEStopBtnPushed = False
                #check why there is a timer   self.timer.stop()
                #self.dialUI.value() = self.dialCenter
                #self.steerHoldValue = self.dialUI.self.dial.value()
                #250608 turn-off USBPad
            elif self.isRunning == True and self.mode == cntrlTristate.USBPAD: 
                breakpoint()
                self.startUSBThread()  #250522 
                print("ln 805 USB should be running\n")
                self.btnStarter.setText('ln 806 Click to Stop USB Controller') #need to switch button text 
                self.btnEStop_toggle_visibility(True)
                #print('hasEStopBtnPushed == False and Navigate with Control Pad\n')
                print('ln 809 A waiting USB Stop signal\n')
                #print('self.btnEStop_toggle_visibility(False)\n')
                self.steerLabel.setText("ln 811 X-out of window to terminate!")
                #self.isRunning = False
                #self.hasEStopBtnPushed = False
                #self.timer.stop()
                #250608 turn-on USBPAD
                print('Start Serial Reader for USB\n')
            else : #assumed self.isRunning == False:
                print('ln 810 hasEStopBtnPushed == False and Starting\n') 
                #print
                self.btnEStop_toggle_visibility(True)
                self.btnStarter.setText('ln 951 Label Reset to Stop') 
                print('ln 952 Starting\n')
                print('ln 953 self.btnEStop_toggle_visibility(True)\n')
                self.isRunning = False
                self.hasEStopBtnPushed = False
                self.steerLabel.setText("ln 920 Rotate  dial handle Port/Starboard to steer")
                #self.timer.start(self.millisecond)
                #self.dialUI.value() = self.dialCenter
                #250528 self.timer.stop()

        else:
            #Assume hasEStopBtnPushed == True
            self.btnEStop_toggle_visibility(False)
            if self.isRunning == True:
                print('ln 929 Emergency Stop.  Full Power-On Reset Required.\n')
                self.steerLabel.setText("ln 930 STOP!! Vehicle Not Drivable! Abandon Vehicle!")
                self.isRunning = False
                self.hasEStopBtnPushed = True
            else: #assumed hasEStopBtnPushed == False
                print('ln 934 Emergency Stop is in effect.  Full Power-On Reset Required.\n')
                self.steerLabel.setText("ln 935 STOP!! Vehicle requires depot level support!")
                self.isRunning = False
                self.hasEStopBtnPushed = True


