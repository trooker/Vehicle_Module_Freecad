import FreeCAD as App
import FreeCADGui as Gui
from PySide2 import QtWidgets, QtCore
from PySide2.QtCore import (Qt, Slot, QTimer)

from aap0038_verysimpleUI2PY import Ui_TestDialog
#from .TaskPanel import createTask

wrkStr = '_00_641_988_steeringAssy'
wrkObjDrvShaft = 'Binder' #'BinderShapeDrvShaft'     #'Body.Binder'
App.Console.PrintMessage('ln 44  ::' + wrkStr + '.'+ wrkObjDrvShaft+'\n')

App.setActiveDocument(wrkStr)
App.ActiveDocument=App.getDocument(wrkStr)
Gui.ActiveDocument=Gui.getDocument(wrkStr)




class TestDialog(QtWidgets.QDialog):
    def __init__(self):
        super().__init__()
        self.ui = Ui_TestDialog()
        self.ui.setupUi(self)
        self.ui.btnAccel.clicked.connect(self.accel)
        self.ui.btnFuel.clicked.connect(self.fuel)
        self.ui.btnFuel.clicked.connect(self.update)
        self.ui.btnAccel.clicked.connect(self.update)
        self.ui.btnCancel.clicked.connect(self.close)

    @Slot()
    def close(self):
        App.Console.PrintMessage("Cancel Button Clicked!\n")
        fina_update(0)

    @Slot()
    def accel(self):
        App.Console.PrintMessage("Accel Button Clicked!\n")
        fina_update(1)

    @Slot()
    def fuel(self):
        App.Console.PrintMessage("Fuel Button Clicked!\n")
        fina_update(2)
 

    def fina_update(self, invalue):
        App.Console.PrintMessage('Final Update: Status: ' + str(invalue) + '\n')
        if invalue == 2:
            self.ui.lblStatus("Fuel")
        elif invalue == 1:
            self.ui.lblStatus("Speed+")
        elif invalue == 0:
            self.ui.lblStatus("Close")
        else:
	        self.ui.lblStatus("Count Down to Off")

    def update(self):
        fina_update(-1)

        

class MyCommand:
    def load(self):
        dialog = TestDialog()
        dialog.exec_()  #works 
        #runs with no response dialog.accept()
        #runs with no response dialog.open()


#Gui.ActiveDocument.addCommand("MyCommand", MyCommand())

fireDialog = MyCommand()
fireDialog.load()

