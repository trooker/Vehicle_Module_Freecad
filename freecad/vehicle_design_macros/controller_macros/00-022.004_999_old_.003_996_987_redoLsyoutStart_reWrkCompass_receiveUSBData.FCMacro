    @Slot()
    def on_dial_changed(self, value):
        print('ln 966 steerlbl on dial change ==>> Label for Port, Starboard, Forward\n')
        if self.isRunning:
            print("ln 968 self.isRunning: True ")
        else: 
            print("ln 970 self.isRunning: False ")
        if self.isRunning == True:
            checkSteerLblText = self.steerLabel.text()
            print("ln 1009:  steerLabel: ", checkSteerLblText )
            print("ln 1010 self.isRunning: True ")
            print("ln 1077 current dial value: ", str(value),"    self.dialLastValue: ", self.dialLastValue, "\n")
            #if value > self.dialLastValue:
            breakpoint()
            if value > self.dialLastValue:
                print("ln 1015 jumped Port")
                self.steerLabel.setText("ln 1007 Port")
                breakpoint() 
                self.usblabel.setText("ln 1018 Port")
                self.steerDirLbl.setText("ln 1019 Port")
                breakpoint()
                ## 1137 self.update_label(96)
                self.dialLastValue = value
            #elif value <  self.dialLastValue:
            elif value < self.dialLastValue:
                breakpoint()
                print("ln 1026 jumped Starboard")
                self.steerLabel.setText("ln 1027 Starboard")
                breakpoint()
                ## 1137 self.update_label(4)
                breakpoint()
                self.usblabel.setText("ln 1027 Starboard")
                self.steerDirLbl.setText("ln 1028 Starboard")
                self.dialLastValue = value 
            else:
                print("ln 989 Does the bus stop here")
            #if  47 <= value <53:
            if  97 <= value < 3:
                breakpoint()
                #self.steerLabel.setText("Forward")
                print("ln 995 Forward  97 <--> 3")
                self.usblabel.setText("ln 996 Forward  97 <--> 3")
                self.steerDirLbl.setText("ln 996 Forward  97 <--> 3")
                breakpoint()
                self.update_label(1)
                self.dialLastValue = value
            print("ln 999 Reached here")
        else: # not running
            print("ln 1001 skipped isRunning: True  Must not be running:  isRunning = False")    
            self.steerLabel.setText('ln 1002 Click the Start/Stop')
            self.steerLabel.setText("ln 1003 Forward")
            self.dialLastValue = value

    def setMainWindow(self):
        self.setModeWindow()
        self.setCntrlWindow()
        self.stacked_layout = QStackedLayout()
        
        self.widgetMode = QWidget()
        self.widgetMode.setLayout(self.modelayout)
        self.widgetCntrl = QWidget()
        self.widgetCntrl.setLayout(self.cntrl_layout)
        self.stacked_layout.addWidget(self.widgetMode)
        self.stacked_layout.addWidget(self.widgetCntrl)

        # Fake switch Button to switch layouts
        #self.switch_button = QPushButton("Switch Layout", self)
        #self.switch_button.clicked.connect(self.switch_layout)

        # Main Layout
        self.main_layout = QVBoxLayout()
        self.main_layout.addLayout(self.stacked_layout) # Add stackedLayout which now holds both layouts
        #self.main_layout.addWidget(self.switch_button)

        self.setLayout(self.main_layout)

        # Set the initial layout index to 0 (Layout 1)
        self.stacked_layout.setCurrentIndex(0)
        print("ln 962   programtically call:  switch_layout()")
        self.switch_layout()   #force a one-time switch of windows

